{
  "name": "replicad-evaluator",
  "version": "1.0.0",
  "description": "Portable code evaluation and shape building for replicad",
  "author": "Steve Genoud <steve@sgenoud.com>",
  "homepage": "https://replicad.xyz",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./evaluate/browser": {
      "types": "./dist/evaluate/browser.d.ts",
      "import": "./dist/evaluate/browser.js"
    }
  },
  "peerDependencies": {
    "replicad": "*"
  },
  "dependencies": {
    "@rollup/browser": "^4.52.5",
    "parse-css-color": "^0.2.1",
    "rollup": "^4.52.5",
    "rollup-plugin-external-globals": "^0.13.0",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "replicad": "^1.0.0",
    "replicad-opencascadejs": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
