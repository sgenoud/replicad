{
  "name": "replicad-threejs-helper",
  "version": "0.23.0",
  "description": "Helper to use threejs to render replicad models",
  "keywords": [
    "cad",
    "threejs",
    "replicad"
  ],
  "author": "Steve Genoud <steve@sgenoud.com>",
  "homepage": "https://replicad.xyz",
  "license": "MIT",
  "main": "dist/cjs/replicad-threejs-helper.cjs",
  "module": "dist/es/replicad-threejs-helper.js",
  "types": "dist/replicad-threejs-helper.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/replicad-threejs-helper.d.ts",
      "import": "./dist/es/replicad-threejs-helper.js",
      "require": "./dist/cjs/replicad-threejs-helper.cjs",
      "default": "./dist/es/replicad-threejs-helper.js"
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgenoud/replicad.git"
  },
  "bugs": {
    "url": "https://github.com/sgenoud/replicad/issues"
  },
  "peerDependencies": {
    "three": ">=0.155.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "start": "vite build --watch",
    "build-doc": "typedoc --exclude \"../replicad-opencascadejs/*\" --out docs --theme minimal src",
    "build-docss": "typedoc --help"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^8.1.0",
    "prettier": "^2.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
